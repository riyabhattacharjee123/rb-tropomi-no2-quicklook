{
  "annotations": {"list": []},
  "panels": [
    {
      "type": "timeseries",
      "title": "Requests/sec by endpoint",
      "targets": [
        {"expr": "sum by (endpoint) (rate(api_requests_total[5m]))", "legendFormat": "{{endpoint}}"}
      ],
      "datasource": {"type": "prometheus", "uid": "PROM"}
    },
    {
      "type": "timeseries",
      "title": "p95 latency (seconds)",
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(api_request_latency_seconds_bucket[5m])) by (le, endpoint))", "legendFormat": "{{endpoint}}"}
      ],
      "datasource": {"type": "prometheus", "uid": "PROM"}
    },
    {
      "type": "timeseries",
      "title": "Errors/sec by endpoint",
      "targets": [
        {"expr": "sum by (endpoint) (rate(api_errors_total[5m]))", "legendFormat": "{{endpoint}}"}
      ],
      "datasource": {"type": "prometheus", "uid": "PROM"}
    }
  ],
  "title": "NO2 Overview",
  "version": 1,
  "schemaVersion": 38
}
